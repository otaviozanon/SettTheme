{
  "name": "theme-sett",
  "version": "1.0.0",
  "displayName": "SETT Theme Pro",
  "description": "A powerful dark theme with golden highlights",
  "publisher": "Otavio Zanon",
  "license": "MIT",
  "scripts": {
    "package": "vsce package -o ./bin/sett.vsix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/otaviozanon/settheme"
  },
  "engines": {
    "vscode": "^1.13.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "icon.png",
  "keywords": [
    "sett",
    "theme",
    "dark",
    "golden",
    "typescript",
    "javascript",
    "react",
    "high-contrast"
  ],
  "galleryBanner": {
    "color": "#17181A",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "SETT Dark Pro",
        "uiTheme": "vs-dark",
        "path": "./theme/sett.json"
      }
    ]
  },
  "devDependencies": {
    "vsce": "^2.15.0"
  },
  "files": [
    "images/**/*.png",
    "images/**/*.svg",
    "theme/**/*.json",
    "icon.png"
  ]
}
